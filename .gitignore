.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.env
# Real company documents must never be committed. Keep them outside the repo
# (DOCS_HOST_DIR) or in data/, which is ignored.
/data/
/documents/
/documentos/
# Office/PDF files anywhere in the repo are assumed to be real documents.
*.pdf
*.docx
*.doc
*.xlsx
*.pptx
# Files uploaded from the panel during a quick start land in examples/docs.
# Only the committed samples are tracked; anything new there stays out of git.
/examples/docs/*/*
/examples/docs/*.*

# Local planning notes and mockups from the development workflow
/.superpowers/
